# Runs pt in the background from login to logout, restarting it if it crashes.
#
# Install:
#   go build -o ~/.local/bin/pt ./cmd/pt
#   mkdir -p ~/.config/pt && cp config.example.yaml ~/.config/pt/config.yaml   # then edit
#   echo 'PT_GCHAT_WEBHOOK=https://chat.googleapis.com/...' > ~/.config/pt/env && chmod 600 ~/.config/pt/env
#   ln -s "$PWD/deploy/pt.service" ~/.config/systemd/user/pt.service
#   systemctl --user daemon-reload && systemctl --user enable --now pt
#
# Then: systemctl --user status pt, journalctl --user -u pt -f

[Unit]
Description=pt: alerts for production errors in code you own
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=%h/.local/bin/pt -config %h/.config/pt/config.yaml
EnvironmentFile=-%h/.config/pt/env
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
